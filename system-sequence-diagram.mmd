sequenceDiagram
    participant User as 用户
    participant Frontend as 前端应用
    participant Backend as 后端API
    participant Service as 业务服务
    participant DB as 数据库
    participant Redis as 缓存
    
    %% 用户登录流程
    User->>Frontend: 输入用户名密码
    Frontend->>Frontend: 验证输入
    Frontend->>Backend: POST /auth/login (用户名, 密码)
    Backend->>Service: UserService.login()
    Service->>DB: 查询用户信息
    alt 用户存在且密码正确
        DB-->>Service: 返回用户信息
        Service->>Redis: 生成并存储token
        Redis-->>Service: 确认存储成功
        Service-->>Backend: 返回登录响应
        Backend-->>Frontend: 200 OK { "token": "...", "user": {...} }
        Frontend->>Frontend: 存储token
        Frontend->>User: 登录成功
    else 用户不存在或密码错误
        DB-->>Service: 返回空
        Service-->>Backend: 抛出认证异常
        Backend-->>Frontend: 401 Unauthorized { "code": 401, "message": "用户名或密码错误" }
        Frontend->>User: 登录失败
    end
    
    %% 获取用户信息流程
    User->>Frontend: 访问需要认证的页面
    Frontend->>Backend: GET /auth/info (Authorization: Bearer token)
    Backend->>Service: 验证token
    Service->>Redis: 验证token有效性
    alt token有效
        Redis-->>Service: token有效
        Service->>DB: 查询用户信息
        DB-->>Service: 返回用户信息
        Service-->>Backend: 返回用户信息
        Backend-->>Frontend: 200 OK { "user": {...} }
        Frontend->>User: 显示用户信息
    else token无效或过期
        Redis-->>Service: token无效
        Service-->>Backend: 抛出认证异常
        Backend-->>Frontend: 401 Unauthorized { "code": 401, "message": "未授权" }
        Frontend->>User: 跳转到登录页
    end
    
    %% 生成课表流程
    User->>Frontend: 填写排课参数
    Frontend->>Backend: POST /timetable/generate (参数)
    Backend->>Service: TimetableService.generate()
    Service->>DB: 查询教学任务
    DB-->>Service: 返回教学任务
    Service->>Service: 执行排课算法
    alt 排课成功
        Service->>DB: 保存课表
        DB-->>Service: 确认保存成功
        Service-->>Backend: 返回课表信息
        Backend-->>Frontend: 200 OK { "timetable": {...} }
        Frontend->>User: 生成成功
    else 排课失败
        Service-->>Backend: 抛出排课异常
        Backend-->>Frontend: 500 Internal Server Error { "code": 500, "message": "排课失败" }
        Frontend->>User: 生成失败
    end
    
    %% 发布课表流程
    User->>Frontend: 点击发布课表
    Frontend->>Backend: POST /timetable/{id}/publish
    Backend->>Service: TimetableService.publish()
    Service->>DB: 更新课表状态
    DB-->>Service: 确认更新成功
    Service-->>Backend: 返回更新后的课表
    Backend-->>Frontend: 200 OK { "timetable": {...} }
    Frontend->>User: 发布成功
    
    %% 调课流程
    User->>Frontend: 填写调课信息
    Frontend->>Backend: POST /adjustment/check (调课参数)
    Backend->>Service: AdjustmentService.check()
    Service->>DB: 检查调课冲突
    alt 无冲突
        DB-->>Service: 无冲突
        Service-->>Backend: 返回检查结果
        Backend-->>Frontend: 200 OK { "conflict": false }
        Frontend->>User: 无冲突，是否执行调课？
        User->>Frontend: 确认执行
        Frontend->>Backend: POST /adjustment/execute (调课参数)
        Backend->>Service: AdjustmentService.execute()
        Service->>DB: 执行调课
        DB-->>Service: 确认调课成功
        Service-->>Backend: 返回调课结果
        Backend-->>Frontend: 200 OK { "result": "success" }
        Frontend->>User: 调课成功
    else 有冲突
        DB-->>Service: 存在冲突
        Service-->>Backend: 返回冲突信息
        Backend-->>Frontend: 200 OK { "conflict": true, "conflicts": [...] }
        Frontend->>User: 存在冲突，调课失败
    end
    
    %% 统计分析流程
    User->>Frontend: 选择统计类型
    Frontend->>Backend: GET /statistics/{type}/{timetableId}
    Backend->>Service: StatisticsService.calculate()
    Service->>DB: 查询统计数据
    DB-->>Service: 返回原始数据
    Service->>Service: 计算统计结果
    Service-->>Backend: 返回统计结果
    Backend-->>Frontend: 200 OK { "statistics": {...} }
    Frontend->>User: 显示统计结果